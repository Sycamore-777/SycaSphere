{
  "CartesianState": {
    "$defs": {
      "CoordinateRepresentation": {
        "description": "Coordinate representations supported by public frame references.",
        "enum": [
          "CARTESIAN",
          "GEODETIC"
        ],
        "title": "CoordinateRepresentation",
        "type": "string"
      },
      "EarthFixedFrameSpec": {
        "additionalProperties": false,
        "description": "Explicit provenance required to interpret an Earth-fixed coordinate frame.",
        "properties": {
          "eop_data_id": {
            "minLength": 1,
            "title": "Eop Data Id",
            "type": "string"
          },
          "iers_conventions": {
            "minLength": 1,
            "title": "Iers Conventions",
            "type": "string"
          },
          "itrf_realization": {
            "minLength": 1,
            "title": "Itrf Realization",
            "type": "string"
          }
        },
        "required": [
          "itrf_realization",
          "iers_conventions",
          "eop_data_id"
        ],
        "title": "EarthFixedFrameSpec",
        "type": "object"
      },
      "Epoch": {
        "additionalProperties": false,
        "description": "An immutable calendar instant whose time scale is always explicit.",
        "properties": {
          "scale": {
            "$ref": "#/$defs/TimeScale"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "value",
          "scale"
        ],
        "title": "Epoch",
        "type": "object"
      },
      "FiniteComponent": {
        "type": "number"
      },
      "FrameKind": {
        "description": "Stable public frame semantics that a backend adapter may implement.",
        "enum": [
          "J2000",
          "EARTH_FIXED",
          "LVLH",
          "VVLH",
          "BODY",
          "SENSOR"
        ],
        "title": "FrameKind",
        "type": "string"
      },
      "FrameRef": {
        "additionalProperties": false,
        "description": "An immutable public frame reference without scientific-backend implementation types.",
        "properties": {
          "convention": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Convention"
          },
          "earth_fixed": {
            "anyOf": [
              {
                "$ref": "#/$defs/EarthFixedFrameSpec"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "ellipsoid": {
            "anyOf": [
              {
                "$ref": "#/$defs/ReferenceEllipsoid"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "kind": {
            "$ref": "#/$defs/FrameKind"
          },
          "owner_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Owner Id"
          },
          "reference_epoch": {
            "anyOf": [
              {
                "$ref": "#/$defs/Epoch"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "representation": {
            "$ref": "#/$defs/CoordinateRepresentation",
            "default": "CARTESIAN"
          }
        },
        "required": [
          "kind"
        ],
        "title": "FrameRef",
        "type": "object"
      },
      "ReferenceEllipsoid": {
        "description": "Reference ellipsoids used only with compatible coordinate representations.",
        "enum": [
          "WGS84"
        ],
        "title": "ReferenceEllipsoid",
        "type": "string"
      },
      "TimeScale": {
        "description": "Supported labels for an Epoch's declared time scale.",
        "enum": [
          "UTC",
          "TAI",
          "TT"
        ],
        "title": "TimeScale",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "An immutable three-dimensional position and velocity state in an explicit frame.",
    "properties": {
      "epoch": {
        "$ref": "#/$defs/Epoch"
      },
      "frame": {
        "$ref": "#/$defs/FrameRef"
      },
      "position_m": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "$ref": "#/$defs/FiniteComponent"
          },
          {
            "$ref": "#/$defs/FiniteComponent"
          },
          {
            "$ref": "#/$defs/FiniteComponent"
          }
        ],
        "title": "Position M",
        "type": "array"
      },
      "velocity_mps": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "$ref": "#/$defs/FiniteComponent"
          },
          {
            "$ref": "#/$defs/FiniteComponent"
          },
          {
            "$ref": "#/$defs/FiniteComponent"
          }
        ],
        "title": "Velocity Mps",
        "type": "array"
      }
    },
    "required": [
      "epoch",
      "frame",
      "position_m",
      "velocity_mps"
    ],
    "title": "CartesianState",
    "type": "object"
  },
