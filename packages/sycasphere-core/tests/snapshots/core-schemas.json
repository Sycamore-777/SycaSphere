  "ErrorDetail": {
    "$defs": {
      "ErrorCategory": {
        "description": "Stable categories for public SycaSphere error payloads.",
        "enum": [
          "VALIDATION_ERROR",
          "PLUGIN_MISSING",
          "PLUGIN_INCOMPATIBLE",
          "BACKEND_INITIALIZATION",
          "EXTERNAL_DATA",
          "UNSUPPORTED_FRAME",
          "UNSUPPORTED_MEASUREMENT",
          "UNAUTHORIZED_DATA_ACCESS",
          "OUT_OF_ORDER",
          "NUMERICAL_FAILURE",
          "RESOURCE_EXHAUSTED",
          "TIMEOUT",
          "CANCELLED",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCategory",
        "type": "string"
      },
      "JsonValue": {}
    },
    "additionalProperties": false,
    "description": "An immutable, JSON-safe payload for errors crossing public boundaries.",
    "properties": {
      "category": {
        "$ref": "#/$defs/ErrorCategory"
      },
      "code": {
        "title": "Code",
        "type": "string"
      },
      "component_ref": {
        "title": "Component Ref",
        "type": "string"
      },
      "context": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Context",
        "type": "object"
      },
      "message": {
        "title": "Message",
        "type": "string"
      },
      "retryable": {
        "title": "Retryable",
        "type": "boolean"
      }
    },
    "required": [
      "category",
      "code",
      "message",
      "retryable",
      "component_ref",
      "context"
    ],
    "title": "ErrorDetail",
    "type": "object"
  },
