  "PluginManifest": {
    "$defs": {
      "JsonValue": {},
      "PluginKind": {
        "description": "First-version plugin kinds the engine may select by declared capability.",
        "enum": [
          "SCIENCE_BACKEND",
          "MEASUREMENT_MODEL",
          "ERROR_MODEL",
          "LINK_MODEL"
        ],
        "title": "PluginKind",
        "type": "string"
      },
      "PluginRef": {
        "additionalProperties": false,
        "description": "Immutable identity and public interface version for a plugin implementation.",
        "properties": {
          "implementation_version": {
            "title": "Implementation Version",
            "type": "string"
          },
          "interface_version": {
            "$ref": "#/$defs/SchemaVersion"
          },
          "plugin_id": {
            "title": "Plugin Id",
            "type": "string"
          }
        },
        "required": [
          "plugin_id",
          "implementation_version",
          "interface_version"
        ],
        "title": "PluginRef",
        "type": "object"
      },
      "ResourceRequirements": {
        "additionalProperties": false,
        "description": "Resource requirements inspectable without importing a plugin implementation.",
        "properties": {
          "minimum_memory_mb": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Minimum Memory Mb"
          },
          "requires_jdk": {
            "default": false,
            "title": "Requires Jdk",
            "type": "boolean"
          },
          "requires_network": {
            "default": false,
            "title": "Requires Network",
            "type": "boolean"
          }
        },
        "title": "ResourceRequirements",
        "type": "object"
      },
      "SchemaVersion": {
        "additionalProperties": false,
        "description": "An immutable public schema version with forward-compatible minors.",
        "properties": {
          "major": {
            "minimum": 0,
            "title": "Major",
            "type": "integer"
          },
          "minor": {
            "minimum": 0,
            "title": "Minor",
            "type": "integer"
          }
        },
        "required": [
          "major",
          "minor"
        ],
        "title": "SchemaVersion",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Immutable, data-only declaration used to select compatible plugin capabilities.",
    "properties": {
      "capabilities": {
        "items": {
          "type": "string"
        },
        "title": "Capabilities",
        "type": "array",
        "uniqueItems": true
      },
      "configuration_schema": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Configuration Schema",
        "type": "object"
      },
      "deterministic": {
        "title": "Deterministic",
        "type": "boolean"
      },
      "kind": {
        "$ref": "#/$defs/PluginKind"
      },
      "ref": {
        "$ref": "#/$defs/PluginRef"
      },
      "resources": {
        "$ref": "#/$defs/ResourceRequirements"
      }
    },
    "required": [
      "ref",
      "kind",
      "capabilities",
      "configuration_schema",
      "deterministic",
      "resources"
    ],
    "title": "PluginManifest",
    "type": "object"
  },
